# ==============================================================================
# EditorConfig — Consistent coding styles across editors and IDEs
# ==============================================================================
# This file defines baseline formatting rules that most editors understand
# natively or via plugins. See https://editorconfig.org for details.
#
# Supported editors: VS Code, IntelliJ IDEA, PyCharm, Sublime Text, Vim,
# Emacs, Atom, and many others.
# ==============================================================================

# Top-most EditorConfig file. Tells plugins not to look in parent directories.
root = true

# ==============================================================================
# Global Rules (Applies to all files unless overridden below)
# ==============================================================================
[*]
charset                  = utf-8       # Use UTF-8 character encoding
end_of_line              = lf          # Use Unix-style line endings (Line Feed)
indent_style             = space       # Use spaces instead of tabs for indentation
indent_size              = 4           # Default indentation is 4 spaces
insert_final_newline     = true        # Ensure files end with a trailing newline
trim_trailing_whitespace = true        # Remove trailing whitespace before saving

# ==============================================================================
# Format-Specific Overrides
# ==============================================================================

# ------------------------------------------------------------------------------
# Python Files
# ------------------------------------------------------------------------------
# Uses project standard of 4 spaces (PEP 8 compatible)
# Note: Line length (110) is enforced by black/flake8/pylint, not EditorConfig
[*.py]
indent_size              = 4
max_line_length          = 110         # Informational only; enforced by linters

# ------------------------------------------------------------------------------
# Data & Configuration Formats
# ------------------------------------------------------------------------------
# Standard practice: 2-space indentation for YAML, JSON, TOML
[*.{yml,yaml,json,toml,ini}]
indent_size              = 2

# ------------------------------------------------------------------------------
# Documentation Formats
# ------------------------------------------------------------------------------
# Markdown: Don't enforce indentation (allows flexibility for nested lists)
[*.md]
indent_size              = unset
trim_trailing_whitespace = false       # Markdown uses trailing spaces for line breaks

# reStructuredText: Match Sphinx default (3 spaces for consistency)
[*.rst]
indent_size              = 3

# ------------------------------------------------------------------------------
# Configuration Files (Specific overrides)
# ------------------------------------------------------------------------------
[.yamllint]
indent_size              = 2

[.editorconfig-checker.json]
indent_size              = 2

# ------------------------------------------------------------------------------
# Build Automation Files
# ------------------------------------------------------------------------------
# Makefiles strictly require physical tabs (not spaces)
[Makefile]
indent_style             = tab         # Tabs are syntactically required by Make
indent_size              = 4           # Tab width display hint

[*.mk]
indent_style             = tab
indent_size              = 4

# ------------------------------------------------------------------------------
# Shell Scripts
# ------------------------------------------------------------------------------
[*.{sh,bash,zsh}]
indent_size              = 2
end_of_line              = lf          # Unix scripts must use LF line endings

# ------------------------------------------------------------------------------
# Docker Files
# ------------------------------------------------------------------------------
[Dockerfile*]
indent_size              = 2

[.dockerignore]
indent_size              = 2
