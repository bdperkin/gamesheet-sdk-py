# ==============================================================================
# Trivy Vulnerability Suppressions
# ==============================================================================
# Suppresses CVEs that are either:
#   1. Not exploitable in this project's context
#   2. No fixed version available yet
#   3. Transitive dependencies of the container base image
#
# See: https://aquasecurity.github.io/trivy/latest/docs/configuration/filtering/
#
# Maintenance: Review suppressed CVEs quarterly. Check if fixed versions are
# available and remove suppressions when possible.
# ==============================================================================

# ------------------------------------------------------------------------------
# Context: Container Base Image System Libraries
# ------------------------------------------------------------------------------
# These vulnerabilities exist in Debian system libraries that are transitive
# dependencies of python:3.11-slim base image. They are NOT direct dependencies
# of this Python project's code.
#
# Risk Assessment: The Python SDK/CLI does not:
#   - Parse XML files directly (libxml2/libexpat vulnerabilities not exploitable)
#   - Use audio libraries (libasound2 vulnerabilities not exploitable)
#   - Interact with GLib DBus internals (glib vulnerabilities not exploitable)
#   - Decompress untrusted archives via gzip
#   - Use PKCS#11 tokens or crypto smartcards
#   - Invoke LLVM toolchain at runtime
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# libxml2 — XML parsing library (not used by this project)
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: None — project does not parse XML
CVE-2026-6653   # Arbitrary code execution in XML parsing

# ------------------------------------------------------------------------------
# libexpat — XML parsing library (not used by this project)
# ------------------------------------------------------------------------------
# Status: No fixed versions available in Debian stable
# Impact: None — project does not parse XML
CVE-2026-56131  # Buffer overflow in XML_GetBuffer
CVE-2026-56132  # Integer overflow in XML_GetBuffer
CVE-2026-56403  # Use-after-free in doContent
CVE-2026-56404  # Heap buffer overflow in build_model
CVE-2026-56405  # Out-of-bounds read in storeAtts
CVE-2026-56406  # Null pointer dereference in poolGrow
CVE-2026-56407  # Stack exhaustion via deeply nested entities
CVE-2026-56408  # Integer overflow in XML_ParseBuffer
CVE-2026-56409  # Heap buffer overflow in addBinding
CVE-2026-56410  # Use-after-free in poolDestroy
CVE-2026-56411  # Integer overflow in poolGrow
CVE-2026-56412  # Out-of-bounds write in storeRawNames

# ------------------------------------------------------------------------------
# libasound2 — ALSA audio library (not used by this project)
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: None — project does not use audio
CVE-2026-56109  # Buffer overflow in snd_pcm_ioplug

# ------------------------------------------------------------------------------
# libacl1 — Access Control Lists library (not used by this project)
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: None — project does not manipulate ACLs
CVE-2026-54369  # Buffer overflow in acl_to_text
CVE-2026-54370  # Integer overflow in acl_copy_entry

# ------------------------------------------------------------------------------
# libattr1 — Extended file attributes library (not used by this project)
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: None — project does not manipulate extended attributes
CVE-2026-54371  # Buffer overflow in attr_list_by_handle

# ------------------------------------------------------------------------------
# libglib2.0-0t64 — GLib core library (system dependency, not directly used)
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: Low — Python runtime uses GLib, but SDK doesn't interact with
#         vulnerable functions directly
CVE-2026-58010  # HIGH: buffer over-read in gvs_tuple_is_normal()
CVE-2026-58011  # HIGH: out-of-bounds read in g_date_time_get_ymd
CVE-2026-58012  # HIGH: buffer over-read in g_regex_replace()
CVE-2026-58013  # HIGH: buffer over-read in g_io_channel_read_line_backend
CVE-2026-58014  # HIGH: off-by-one error in g_key_file_get_locale_string_list
CVE-2026-58015  # HIGH: path traversal in gdbusauthmechanismsha1.c
CVE-2026-58016  # CRITICAL: integer underflow in g_dbus_node_info_new_for_xml

# ------------------------------------------------------------------------------
# gzip — Compression utility (not used for untrusted data)
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: Low — project does not decompress untrusted archives
CVE-2026-41991  # MEDIUM: arbitrary file overwrite in gzexe utility
CVE-2026-41992  # HIGH: global buffer overflow in LZH decompression

# ------------------------------------------------------------------------------
# util-linux family — System utilities (mount, login, blkid, etc.)
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: Low — core system utilities not directly invoked by Python SDK
# Affects: bsdutils, libblkid1, liblastlog2-2, libmount1, libsmartcols1,
#          libuuid1, login, mount, util-linux
CVE-2026-13595  # MEDIUM: heap use-after-free in libblkid nested partition probing

# ------------------------------------------------------------------------------
# p11-kit — PKCS#11 toolkit for crypto tokens
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: None — project does not use crypto tokens or smartcards
CVE-2026-13757  # MEDIUM: stack exhaustion via unbounded recursion in RPC parsing

# ------------------------------------------------------------------------------
# LLVM — Compiler infrastructure
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: None — LLVM is a build-time dependency, not invoked at runtime
CVE-2026-13573  # LOW: DoS via stack buffer overflow in StringMap::insert
CVE-2026-13574  # LOW: DoS via heap buffer overflow in Bitcode File Handler

# ------------------------------------------------------------------------------
# NSS — Network Security Services
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: Low — NSS is used by system networking, SDK uses Python's ssl module
CVE-2026-12318  # LOW: incorrect boundary conditions in NSS Libraries component

# ------------------------------------------------------------------------------
# libxml2 — Additional vulnerabilities
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: None — project does not use xmlcatalog utility
CVE-2026-11979  # LOW: arbitrary code execution in xmlcatalog utility

# ------------------------------------------------------------------------------
# X11 / Xvfb / libxfont2 — X Window System libraries
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: Low — Xvfb is used by Playwright for headless browser automation only
#         The SDK does not directly process X11 protocol or font files from
#         untrusted sources. Browser rendering happens inside Chromium's sandbox.
# Context: These libraries are required for headless Chromium via Playwright
CVE-2026-55999  # glamor Font Atlas Heap Buffer Overflow
CVE-2026-56000  # GLX contextTags Use-After-Free in CommonMakeCurrent()
CVE-2026-56001  # BitmapScaleBitmaps Integer Overflow Heap Buffer Overflow
CVE-2026-56002  # PCF Font Parsing Heap Buffer Overflow
CVE-2026-56003  # computeProps Property Buffer Heap Buffer Overflow

# ------------------------------------------------------------------------------
# FreeType — Font rendering library
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: Low — FreeType is used by Xvfb/Chromium for font rendering
#         The SDK does not directly parse font files from untrusted sources
CVE-2026-50811  # Out-of-bounds read vulnerability in FreeType 2.14.3+

# ------------------------------------------------------------------------------
# Perl — Perl language runtime
# ------------------------------------------------------------------------------
# Status: No fixed version available in Debian stable
# Impact: None — Perl is a build/system dependency, not invoked by Python SDK
#         The HTTP::Tiny credential forwarding issue doesn't affect Python code
CVE-2026-7017   # HTTP::Tiny forwards credential headers to redirects

