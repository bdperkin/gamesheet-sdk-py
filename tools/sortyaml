# --- Indent detection ---


def _has_lc(val: object, typ: type) -> bool:
    """Check if *val* is a non-empty instance of *typ* with line/column data.

    Returns:
        bool: True if *val* matches *typ*, is non-empty, and has lc data.
    """
    return isinstance(val, typ) and bool(val) and hasattr(val, "lc")


def _iter_children(node: object) -> Iterator[object]:
    """Yield child nodes from lists and sequences."""
    if isinstance(node, (list, CommentedSeq)):
        yield from node


def _map_indents(node: object) -> Iterator[int]:
    """Yield mapping-indent deltas found in the data tree."""
    if not _has_lc(node, CommentedMap):
        for item in _iter_children(node):
            yield from _map_indents(item)

        return

    for key in node:  # type: ignore[attr-defined]
        val = node[key]  # type: ignore[index]
        if _has_lc(val, CommentedMap):
            keys = list(val.keys())
            yield val.lc.key(keys[0])[1] - node.lc.key(key)[1]  # type: ignore[attr-defined]

        yield from _map_indents(val)


def _seq_indents(node: object) -> Iterator[int]:
    """Yield sequence-indent deltas found in the data tree."""
    if not _has_lc(node, CommentedMap):
        for item in _iter_children(node):
            yield from _seq_indents(item)

        return

    for key in node:  # type: ignore[attr-defined]
        val = node[key]  # type: ignore[index]
        if _has_lc(val, CommentedSeq):
            yield val.lc.item(0)[1] - node.lc.key(key)[1]  # type: ignore[attr-defined]

        yield from _seq_indents(val)


def _detect_indent(data: object) -> tuple[int, int, int]:
    """Detect mapping indent, sequence indent, and dash offset from loaded YAML.

    Returns:
        tuple[int, int, int]: ``(mapping_indent, sequence_indent, dash_offset)``.
    """
    mi = next(_map_indents(data), 2)
    si = next(_seq_indents(data), 2)
    return mi, si, max(si - 2, 0)


# --- Schema-specific sorting ---

SortKeyFn = Callable[[str, object, int, int], tuple[object, ...]]


def _ordered_key_pos(key: str, order: tuple[str, ...]) -> int:
    """Return the position of *key* in *order*, or ``len(order)`` if absent."""
    try:
        return order.index(key)
    except ValueError:
        return len(order)


def _type_order(value: object) -> int:
    """Return 0 for scalars, 1 for mappings, 2 for sequences."""
    if isinstance(value, CommentedMap):
        return 1

    if isinstance(value, (list, CommentedSeq)):
        return 2

    return 0


