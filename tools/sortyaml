def _codecov_top_sort_key(key: str) -> tuple[int, str]:
    """Return sort key for a codecov top-level key."""
    return (_ordered_key_pos(key, _CODECOV_TOP_LEVEL), key)


def _codecov_nested_sort_key(key: str, value: object) -> tuple[int, int, int, str]:
    """Return sort key for a nested codecov key (name first, scalars first)."""
    if key == "name":
        return (0, _type_order(value), 0, key)

    name_order = 0 if key.startswith("default") else 1
    return (1, _type_order(value), name_order, key)


def _codecov_sort_key(
    key: str,
    value: object,
    depth: int,
    _pos: int,
) -> tuple[object, ...]:
    """Return sort key for a codecov key at the given depth."""
    if not depth:
        return _codecov_top_sort_key(key)

    return _codecov_nested_sort_key(key, value)


