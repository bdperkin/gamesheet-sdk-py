) -> tuple[object, ...]:
    """Return sort key for a GitHub Actions workflow key at the given depth."""
    if depth == 1 and _is_job_value(value):
        return (pos,)

    sort_key = "on" if key is True else key  # type: ignore[comparison-overlap]  # bare `on` is YAML boolean
