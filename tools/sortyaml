# --- Identity-key sorting ---

_IDENTITY_KEYS = ("name", "id", "uses", "repo")


def _identity_key_pos(key: str) -> int:
    """Return the priority position for an identity key, or len for non-identity."""
    return _ordered_key_pos(key, _IDENTITY_KEYS)


def _schema_key_fn(
    data: CommentedMap,
    sort_key_fn: SortKeyFn,
    depth: int,
) -> Callable[[str], tuple[object, ...]]:
    """Return a sort key function wrapping a schema sort key."""
    positions = {k: i for i, k in enumerate(data)}
    return lambda k: sort_key_fn(k, data[k], depth, positions[k])


def _identity_key_fn(
    data: CommentedMap,
    sort_key_fn: SortKeyFn | None,
    depth: int,
) -> Callable[[str], tuple[object, ...]]:
    """Return a sort key function that puts identity keys first."""
    base: Callable[[str], object] = _schema_key_fn(data, sort_key_fn, depth) if sort_key_fn else str

    def _key(k: str, b: Callable[[str], object] = base) -> tuple[object, ...]:
        return (_identity_key_pos(k), b(k))

    return _key


# --- Sorting ---


def _save_comments(data: CommentedMap) -> dict[str, object]:
    """Save comment associations from a CommentedMap.

    Returns:
        dict[str, object]: Mapping of key to comment data.
    """
    return {k: data.ca.items[k] for k in data if k in data.ca.items}


def _sorted_pairs(
    data: CommentedMap,
    sort_key_fn: SortKeyFn | None = None,
    depth: int = 0,
    *,
    in_seq: bool = False,
) -> list[tuple[str, object]]:
    """Return key-value pairs sorted by the given sort key function."""
    key_fn: Callable[[str], tuple[object, ...] | str]
    if sort_key_fn:
        key_fn = _schema_key_fn(data, sort_key_fn, depth)
    elif in_seq:
        key_fn = _identity_key_fn(data, sort_key_fn, depth)
    else:
        key_fn = str

    return [(k, data[k]) for k in sorted(data.keys(), key=key_fn)]


def _walk_merge_ids(data: object, ids: set[int], visited: set[int]) -> bool:
    """Return True if *data* is or contains a merge-involved map."""
    if not isinstance(data, (CommentedMap, list, CommentedSeq)):
        return False

    obj_id = id(data)
    if obj_id in visited:
        return obj_id in ids

    visited.add(obj_id)
    if isinstance(data, CommentedMap):
        merge = getattr(data, "merge", None)
        if merge:
            ids.add(obj_id)
            for merged_map in merge:
                if isinstance(merged_map, CommentedMap):
                    ids.add(id(merged_map))

        has_merge_child = False
        for value in data.values():
            if _walk_merge_ids(value, ids, visited):
                has_merge_child = True

        if has_merge_child:
            ids.add(obj_id)

        return obj_id in ids

    for item in data:
        _walk_merge_ids(item, ids, visited)

    return False


def _collect_merge_ids(data: object) -> set[int]:
    """Pre-scan the tree for all CommentedMaps involved in merge-key relationships.

    Returns ids of maps that use ``<<``, maps referenced as merge sources, and parent maps whose values
    include any merge-involved map (reordering those parents would break anchor-before-reference ordering).

    Returns:
        set[int]: Object ids of merge-involved CommentedMaps.
    """
    ids: set[int] = set()
    _walk_merge_ids(data, ids, set())
    return ids


def _sort_map_keys(
    data: CommentedMap,
    sort_key_fn: SortKeyFn | None = None,
    depth: int = 0,
    *,
    strict: bool = True,
    in_seq: bool = False,
    merge_ids: set[int] | None = None,
) -> None:
    """Sort a single CommentedMap's keys in place and recurse into values."""
    if merge_ids and id(data) in merge_ids:
        logger.debug("Skipping sort of merge-involved map at depth %d", depth)
        for value in data.values():
            _sort_mapping(value, sort_key_fn, depth + 1, strict=strict, merge_ids=merge_ids)

        return

    saved = _save_comments(data)
    pairs = _sorted_pairs(data, sort_key_fn, depth, in_seq=in_seq)
    for k in list(data.keys()):
        del data[k]

    data.ca.items.clear()
    for key, value in pairs:
        data[key] = value
        if key in saved:
            data.ca.items[key] = saved[key]

        _sort_mapping(value, sort_key_fn, depth + 1, strict=strict, merge_ids=merge_ids)


def _sort_mapping(
    data: object,
    sort_key_fn: SortKeyFn | None = None,
    depth: int = 0,
    *,
    strict: bool = True,
    in_seq: bool = False,
    merge_ids: set[int] | None = None,
) -> None:
    """Recursively sort CommentedMap keys, preserving attached comments."""
    if isinstance(data, CommentedMap):
        _sort_map_keys(data, sort_key_fn, depth, strict=strict, in_seq=in_seq, merge_ids=merge_ids)
    elif isinstance(data, (list, CommentedSeq)):
        for item in data:
            _sort_mapping(
                item,
                sort_key_fn,
                depth,
                strict=strict,
                in_seq=not strict,
                merge_ids=merge_ids,
            )


def _should_fold(value: object, key: str, indent: int, depth: int, width: int) -> bool:
    """Return True if a quoted string value would wrap when rendered inline."""
    if not isinstance(value, (DoubleQuotedScalarString, SingleQuotedScalarString)):
        return False

    if "\n" in str(value):
        return False

    inline_len = depth * indent + len(key) + 4 + len(str(value))
    return inline_len > width


def _fold_map_strings(
    data: CommentedMap,
    indent: int,
    depth: int,
    width: int,
) -> None:
    """Fold long quoted strings in a CommentedMap to block scalar style."""
    for key in data:
        value = data[key]
        if _should_fold(value, key, indent, depth, width):
            data[key] = FoldedScalarString(str(value))

        _fold_long_strings(value, indent, depth + 1, width)


def _fold_long_strings(
    data: object,
    indent: int,
    depth: int = 0,
    width: int = 110,
) -> None:
    """Walk data tree and convert long quoted strings to >- block scalars."""
    if isinstance(data, CommentedMap):
        _fold_map_strings(data, indent, depth, width)
    elif isinstance(data, (list, CommentedSeq)):
        for item in data:
            _fold_long_strings(item, indent, depth, width)


def _preserve_anchors(data: object, visited: set[int] | None = None) -> None:
    """Force all YAML anchors to emit even when no alias references them."""
    if visited is None:
        visited = set()

    obj_id = id(data)
    if obj_id in visited:
        return

    visited.add(obj_id)
    anchor = getattr(data, "anchor", None)
    if anchor and anchor.value:
        anchor.always_dump = True

    if isinstance(data, CommentedMap):
        for value in data.values():
            _preserve_anchors(value, visited)
    elif isinstance(data, (list, CommentedSeq)):
        for item in data:
            _preserve_anchors(item, visited)


def _render(yml: YAML, data: object) -> str:
    """Dump YAML data to a string.

    Returns:
        str: Rendered YAML text.
    """
    _preserve_anchors(data)
    buf = io.StringIO()
    yml.dump(data, buf)
    return buf.getvalue()


# --- CLI helpers ---


def _validate_args(*, backup: bool, is_stdin: bool) -> None:
    """Reject invalid flag combinations.

    Raises:
        SystemExit: If --backup is used with stdin.
    """
    if backup and is_stdin:
        console.print("[bold red]Error:[/] --backup cannot be used with stdin")
        raise SystemExit(2)


def _load_yaml(file: io.TextIOWrapper) -> tuple[str, object, YAML]:
    """Read and parse YAML from *file*.

    Args:
        file (io.TextIOWrapper): Input file handle.

    Returns:
        tuple[str, object, YAML]: ``(original_text, parsed_data, yaml_instance)``.

    Raises:
        SystemExit: If YAML parsing fails.
    """
    original = file.read()
    yml = YAML()
    yml.preserve_quotes = True
    if original.startswith("---"):
        yml.explicit_start = True

    try:
        data = yml.load(original)
    except Exception as exc:
        console.print(f"[bold red]Error:[/] Failed to parse YAML: {exc}")
        raise SystemExit(2) from exc

    return original, data, yml


def _handle_empty(original: str, *, is_stdin: bool, check: bool, diff: bool) -> None:
    """Pass through empty/comment-only documents on stdin in write mode."""
    logger.info("Empty document, nothing to sort")
    if is_stdin and not check and not diff:
        sys.stdout.write(original)


def _sort_and_render(
    data: object,
    yml: YAML,
    sort_key_fn: SortKeyFn | None = None,
    *,
    strict: bool = True,
) -> str:
    """Detect indent, sort keys, render to string, and format with yamlfix.

    Returns:
        str: Sorted, rendered, and yamlfix-formatted YAML text.
    """
    mi, si, do = _detect_indent(data)
    yml.indent(mapping=mi, sequence=si, offset=do)
    logger.info("Detected indent: mapping=%d, sequence=%d, offset=%d", mi, si, do)
    merge_ids = _collect_merge_ids(data)
    if merge_ids:
        logger.info("Found %d merge-involved maps, skipping their key reorder", len(merge_ids))

    _sort_mapping(data, sort_key_fn, strict=strict, merge_ids=merge_ids)
    _fold_long_strings(data, mi)
    return format_yaml(_render(yml, data))


def _show_diff(original: str, sorted_text: str, source: str) -> None:
    """Print colorized unified diff to stdout if content changed."""
    if original == sorted_text:
        return

    lines = difflib.unified_diff(
        original.splitlines(keepends=True),
        sorted_text.splitlines(keepends=True),
        fromfile=f"a/{source}",
        tofile=f"b/{source}",
    )
    Console().print(Syntax("".join(lines).rstrip("\n"), "diff", theme="ansi_dark"))


def _run_check(original: str, sorted_text: str, source: str, *, showed_diff: bool) -> None:
    """Exit 1 if content is not sorted.

    Raises:
        SystemExit: If content is not already sorted.
    """
    if original == sorted_text:
        logger.info("%s already sorted", source)
        return

    if not showed_diff:
        console.print(f"[bold yellow]{source}[/] would be resorted")

    raise SystemExit(1)


def _write_result(sorted_text: str, source: str, *, is_stdin: bool, backup: bool) -> None:
    """Write sorted YAML to stdout (stdin mode) or back to file."""
    if is_stdin:
        sys.stdout.write(sorted_text)
        return

    path = Path(source)
    if backup:
        bak_path = path.with_suffix(path.suffix + ".bak")
        shutil.copy2(path, bak_path)
        logger.info("Backup: %s", bak_path)

    path.write_text(sorted_text, encoding="utf-8")
    logger.info("Sorted %s", source)


# --- CLI command ---


@click.command("sortyaml")
@click.argument("file", type=click.File("r"), default="-")
@click.option("-v", "--verbose", is_flag=True, help="Enable verbose output.")
@click.option(
    "-b",
    "--backup",
    is_flag=True,
    help="Create a .bak backup before modifying.",
)
@click.option(
    "-c",
    "--check",
    is_flag=True,
    help="Check if already sorted; exit 1 if not.",
)
@click.option("-d", "--diff", is_flag=True, help="Show unified diff of changes.")
@click.option(
    "-t",
    "--type",
    "schema_type",
    type=click.Choice(sorted(_SCHEMA_SORT_KEYS)),
    default=None,
    help="Apply schema-specific sorting rules.",
)
@click.option(
    "-s",
    "--strict",
    is_flag=True,
    help="Disable identity-key-first sorting in sequence elements.",
)
@click.version_option(None, "-V", "--version", package_name=PROJECT_NAME)
@click.help_option("-h", "--help")
def app(
    file: io.TextIOWrapper,
    *,
    verbose: bool,
    backup: bool,
    check: bool,
    diff: bool,
    schema_type: str | None,
    strict: bool,
) -> None:
    """Sort YAML file keys alphabetically while preserving comments.

    FILE is the YAML file to sort. Use - or omit for stdin.

    Args:
        file (io.TextIOWrapper): Input file handle (or stdin).
        verbose (bool): Enable verbose output.
        backup (bool): Create a .bak backup before modifying.
        check (bool): Check if already sorted; exit 1 if not.
        diff (bool): Show unified diff of changes.
        schema_type (str | None): Schema type for schema-specific sorting rules.
        strict (bool): Disable identity-key-first sorting in sequence elements.
    """
    configure_logging(_LOG_LEVELS[verbose], console)
    is_stdin = file.name == "<stdin>"
    _validate_args(backup=backup, is_stdin=is_stdin)
    logger.info("Reading %s", file.name)
    original, data, yml = _load_yaml(file)
    if data is None:
        _handle_empty(original, is_stdin=is_stdin, check=check, diff=diff)
        return

    sort_key_fn = _SCHEMA_SORT_KEYS.get(schema_type) if schema_type else None
    sorted_text = _sort_and_render(data, yml, sort_key_fn, strict=strict)
    if diff:
        _show_diff(original, sorted_text, file.name)
        if not check:
            return

    if check:
        _run_check(original, sorted_text, file.name, showed_diff=diff)
        return

    _write_result(sorted_text, file.name, is_stdin=is_stdin, backup=backup)


if __name__ == "__main__":
    sys.argv[0] = re.sub(r"(-script\.pyw|\.exe)?$", "", sys.argv[0])
    app()
