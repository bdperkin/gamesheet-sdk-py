---
# ==============================================================================
# YAML Lint Configuration
# ==============================================================================
# Enforces consistent YAML formatting across the project.
# Used by yamllint (https://yamllint.readthedocs.io/) in pre-commit hooks
# and CI workflows.
#
# This configuration is tuned for GitHub Actions workflows and CI/CD files,
# which often have long lines and don't require document-start markers.
# ==============================================================================

# Inherit the base ruleset from the default yamllint configuration
extends: default

# ------------------------------------------------------------------------------
# Global Ignored Paths
# ------------------------------------------------------------------------------
# Directories and patterns to exclude from linting
ignore: |
  /_build/
  /.local/
  /.pytest_cache/
  /.venv/
  /node_modules/

# ------------------------------------------------------------------------------
# Rule Customizations & Overrides
# ------------------------------------------------------------------------------
rules:

  # ----------------------------------------------------------------------------
  # Brackets and Braces
  # ----------------------------------------------------------------------------
  # Enforce spacing inside brackets and braces for readability
  braces:
    max-spaces-inside: 0
    min-spaces-inside: 0
  brackets:
    max-spaces-inside: 0
    min-spaces-inside: 0

  # ----------------------------------------------------------------------------
  # Comments
  # ----------------------------------------------------------------------------
  # Allow inline comments without requiring a space before them
  comments:
    min-spaces-from-content: 1 # Require at least 1 space before inline comment

  # ----------------------------------------------------------------------------
  # Document End
  # ----------------------------------------------------------------------------
  # Disable the requirement for '...' at the end of YAML files
  document-end: disable

  # ----------------------------------------------------------------------------
  # Document Start
  # ----------------------------------------------------------------------------
  # Disable the requirement for '---' at the top of every YAML file
  # GitHub Actions workflows don't use document-start markers
  document-start: disable

  # ----------------------------------------------------------------------------
  # Empty Lines
  # ----------------------------------------------------------------------------
  # Allow reasonable flexibility with blank lines
  empty-lines:
    max: 2 # Allow up to 2 consecutive blank lines

  # ----------------------------------------------------------------------------
  # Indentation
  # ----------------------------------------------------------------------------
  # Enforce strict and consistent 2-space indentation throughout
  indentation:
    check-multi-line-strings: false # Don't enforce indentation in multi-line strings
    indent-sequences: true # Enforce correct indentation for list items (-)
    spaces: 2 # Standardize on 2 spaces for nested blocks

  # ----------------------------------------------------------------------------
  # Line Length
  # ----------------------------------------------------------------------------
  # Allow longer lines for GitHub Actions workflows and complex configurations
  # Default is 80, but CI workflows often have long URLs, paths, and commands
  line-length:
    allow-non-breakable-inline-mappings: true # allow non-breakable words in inline mappings
    allow-non-breakable-words: true # allow non breakable words (without spaces inside) to overflow the limit
    max: 110 # Allow up to 110 characters per line

  # ----------------------------------------------------------------------------
  # Quoted Strings
  # ----------------------------------------------------------------------------
  # Don't enforce quoting style (allow both single and double quotes)
  # Different contexts call for different styles
  quoted-strings: disable

  # ----------------------------------------------------------------------------
  # Truthy Values
  # ----------------------------------------------------------------------------
  # Allow flexible boolean representations (yes/no, true/false, on/off)
  # GitHub Actions uses 'true'/'false', while some tools prefer 'yes'/'no'
  truthy:
    allowed-values:
      - "true"
      - "false"
      - "yes"
      - "no"
      - "on"
      - "off"
    check-keys: false # Don't check key names for truthy values
